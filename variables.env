SHELL=/bin/bash
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=nv-devx

# --- Local-first fork: every model call stays on this DGX Spark -------------------
# One URL for chat, embeddings and reranking. ChatNVIDIA, NVIDIAEmbeddings,
# NVIDIARerank and the workshop's ChatOpenAI calls all read it. Start the
# "local-models" Compose profile first. Delete this line to use NVIDIA's hosted API.
NVIDIA_BASE_URL=http://local-gateway:8000/v1
# Model names as the local servers report them (GET /v1/models).
WORKSHOP_CHAT_MODEL=nvidia/Qwen3.8-27B-NVFP4
WORKSHOP_FAST_CHAT_MODEL=nvidia/Qwen3.8-27B-NVFP4
WORKSHOP_JUDGE_MODEL=nvidia/Qwen3.8-27B-NVFP4
WORKSHOP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
WORKSHOP_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
# Search for the report agent: "local" = data/it-knowledge-base, no key, no internet.
# "tavily" = the original web search; needs TAVILY_API_KEY in Secrets Manager.
WORKSHOP_SEARCH=local
